{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia.local/contracts/events/v1/payloads/book-closed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["progress", "closedAt", "reason"],
  "properties": {
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "chapter": { "type": "string", "maxLength": 500 },
    "closedAt": { "type": "string", "format": "date-time" },
    "reason": { "enum": ["explicit", "backgrounded", "navigated_away"] }
  }
}
