{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia.local/contracts/events/v1/payloads/conversation-resumed.schema.json",
  "title": "conversation_resumed payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["resumedAt"],
  "properties": {
    "resumedAt": { "type": "string", "format": "date-time" },
    "messageCount": { "type": "integer", "minimum": 0 },
    "chapter": { "type": "string", "maxLength": 300 },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
