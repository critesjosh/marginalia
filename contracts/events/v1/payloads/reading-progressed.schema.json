{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia.local/contracts/events/v1/payloads/reading-progressed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["progress", "observedAt", "trigger"],
  "properties": {
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "chapter": { "type": "string", "maxLength": 500 },
    "observedAt": { "type": "string", "format": "date-time" },
    "trigger": { "enum": ["progress_delta", "chapter_change", "closing", "backgrounded"] }
  }
}
