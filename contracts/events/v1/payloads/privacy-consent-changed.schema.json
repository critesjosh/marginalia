{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia.local/contracts/events/v1/payloads/privacy-consent-changed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["changed", "consentUpdatedAt"],
  "properties": {
    "changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "enabled"],
        "properties": {
          "category": {
            "enum": [
              "usageMetadata",
              "bookMetadata",
              "highlightText",
              "highlightNotes",
              "conversationText",
              "assistantText",
              "bookMemory",
              "surroundingContext"
            ]
          },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "consentUpdatedAt": { "type": "string", "format": "date-time" }
  }
}
