{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia.local/contracts/events/v1/envelope.schema.json",
  "title": "Marginalia event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "installationId",
    "sequence",
    "source",
    "appVersion",
    "eventType",
    "eventTime",
    "emittedAt",
    "entities",
    "privacy",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["pwa", "koreader"] },
    "appVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "eventType": {
      "enum": [
        "privacy_consent_changed",
        "highlight_created",
        "highlight_updated",
        "highlight_deleted",
        "conversation_started",
        "question_asked"
      ]
    },
    "eventTime": { "type": "string", "format": "date-time" },
    "emittedAt": { "type": "string", "format": "date-time" },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bookId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "highlightId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentVersion", "included"],
      "properties": {
        "consentVersion": { "const": 1 },
        "included": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bookMetadata",
              "highlightText",
              "highlightNotes",
              "conversationText",
              "assistantText",
              "bookMemory",
              "surroundingContext"
            ]
          }
        }
      }
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated", "highlight_deleted"] }
        }
      },
      "then": {
        "properties": { "entities": { "type": "object", "required": ["bookId", "highlightId"] } }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "conversation_started" } } },
      "then": {
        "properties": {
          "entities": { "type": "object", "required": ["bookId", "conversationId"] },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "items": { "type": "string", "const": "conversationText" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "question_asked" } } },
      "then": {
        "properties": {
          "entities": { "type": "object", "required": ["bookId", "conversationId", "messageId"] },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "items": { "type": "string", "const": "conversationText" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "privacy_consent_changed" } } },
      "then": {
        "properties": {
          "privacy": { "type": "object", "properties": { "included": { "type": "array", "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "highlight_deleted" } } },
      "then": {
        "properties": {
          "privacy": { "type": "object", "properties": { "included": { "type": "array", "maxItems": 0 } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated"] }
        }
      },
      "then": {
        "properties": {
          "privacy": {
            "type": "object",
            "properties": {
              "included": {
                "type": "array",
                "items": { "type": "string", "enum": ["highlightText", "highlightNotes"] }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated"] },
          "payload": { "type": "object", "required": ["text"] }
        },
        "required": ["eventType", "payload"]
      },
      "then": {
        "properties": {
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "highlightText" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated"] },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "highlightText" } }
            },
            "required": ["included"]
          }
        },
        "required": ["eventType", "privacy"]
      },
      "then": {
        "properties": { "payload": { "type": "object", "required": ["text"] } }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated"] },
          "payload": { "type": "object", "required": ["note"] }
        },
        "required": ["eventType", "payload"]
      },
      "then": {
        "properties": {
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "highlightNotes" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["highlight_created", "highlight_updated"] },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "highlightNotes" } }
            },
            "required": ["included"]
          }
        },
        "required": ["eventType", "privacy"]
      },
      "then": {
        "properties": { "payload": { "type": "object", "required": ["note"] } }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "const": "conversation_started" },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "conversationText" } }
            },
            "required": ["included"]
          }
        },
        "required": ["eventType", "privacy"]
      },
      "then": {
        "properties": { "payload": { "type": "object", "required": ["title"] } }
      },
      "else": {
        "properties": {
          "payload": {
            "type": "object",
            "not": { "anyOf": [{ "required": ["title"] }, { "required": ["seedText"] }] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": { "const": "question_asked" },
          "privacy": {
            "type": "object",
            "properties": {
              "included": { "type": "array", "contains": { "const": "conversationText" } }
            },
            "required": ["included"]
          }
        },
        "required": ["eventType", "privacy"]
      },
      "then": {
        "properties": { "payload": { "type": "object", "required": ["content"] } }
      },
      "else": {
        "properties": {
          "payload": { "type": "object", "not": { "required": ["content"] } }
        }
      }
    }
  ]
}
