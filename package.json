{
  "name": "epub-chat-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloudflare": "npm run build && tsc -p tsconfig.cloudflare.json",
    "cloudflare:types": "wrangler types workers/app/worker-configuration.d.ts --env-file workers/app/.dev.vars.example --include-runtime false --strict-vars false",
    "types:generate": "npm run cloudflare:types",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "lint": "oxlint --deny-warnings && node scripts/check-lua.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.cloudflare.json",
    "test": "vitest run",
    "test:list": "vitest list",
    "test:coverage": "vitest run --coverage",
    "test:qa": "playwright test",
    "test:qa:canary": "playwright test --config playwright.canary.config.ts",
    "format": "prettier --write src shared workers/app/src koreader/tests tests scripts *.config.ts .github && stylua koreader/marginalia.koplugin koreader/tests --verify",
    "format:check": "prettier --check src shared workers/app/src koreader/tests tests scripts *.config.ts .github && stylua --check koreader/marginalia.koplugin koreader/tests",
    "quality": "npm run format:check && knip --no-progress && jscpd && node scripts/quality.mjs && node scripts/check-docs.mjs && node scripts/check-flags.mjs && node scripts/check-contracts.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "setup": "sh scripts/setup.sh",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/charis-sil": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "epubjs": "^0.3.93",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@johnnymorganz/stylua-bin": "2.5.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "fake-indexeddb": "6.2.5",
    "jscpd": "5.4.0",
    "jsdom": "^30.1.1",
    "knip": "6.40.0",
    "luaparse": "0.3.1",
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "rolldown": "1.2.12",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wasmoon": "1.16.0",
    "wrangler": "^4.125.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    },
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
