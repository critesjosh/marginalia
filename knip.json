{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "workers/**/src/index.ts",
    "{src,shared,dev,koreader/tests,workers}/**/*.test.ts",
    "tests/**/*.spec.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "{src,shared,dev,workers,koreader/tests}/**/*.{ts,tsx,css}",
    "*.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts"
  ],
  "ignoreDependencies": ["@fontsource/alegreya-sans"],
  "playwright": { "config": ["playwright.config.ts", "playwright.canary.config.ts"] }
}
