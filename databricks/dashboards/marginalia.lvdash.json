{
  "datasets": [
    {
      "name": "interests",
      "displayName": "Reader interest profile",
      "queryLines": [
        "SELECT concept_id, interest_score, evidence_count, distinct_books,\n",
        "       score_version, computed_at\n",
        "FROM IDENTIFIER(:gold_schema || '.reader_interest_profile')\n",
        "ORDER BY interest_score DESC"
      ],
      "parameters": [
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": { "dataType": "STRING", "values": [{ "value": "marginalia.marginalia_gold" }] }
          }
        }
      ]
    },
    {
      "name": "engagement",
      "displayName": "Book engagement",
      "queryLines": [
        "SELECT book_id, engagement_score, active_minutes, session_count,\n",
        "       current_highlights, questions, completed, computed_at\n",
        "FROM IDENTIFIER(:gold_schema || '.book_engagement')\n",
        "ORDER BY engagement_score DESC"
      ],
      "parameters": [
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": { "dataType": "STRING", "values": [{ "value": "marginalia.marginalia_gold" }] }
          }
        }
      ]
    },
    {
      "name": "frontier",
      "displayName": "Intellectual frontier",
      "queryLines": [
        "SELECT candidate_concept, frontier_score, neighbour_count,\n",
        "       supporting_work_count, computed_at\n",
        "FROM IDENTIFIER(:gold_schema || '.intellectual_frontier')\n",
        "ORDER BY frontier_score DESC"
      ],
      "parameters": [
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": { "dataType": "STRING", "values": [{ "value": "marginalia.marginalia_gold" }] }
          }
        }
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "interests_bar",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "interests",
                  "fields": [
                    { "name": "concept_id", "expression": "`concept_id`" },
                    { "name": "interest_score", "expression": "`interest_score`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "concept_id", "scale": { "type": "categorical" }, "displayName": "Concept" },
                "y": { "fieldName": "interest_score", "scale": { "type": "quantitative" }, "displayName": "Interest" }
              },
              "frame": {
                "title": "Interest by concept, normalized within this reader",
                "showTitle": true,
                "description": "Scores are comparable within a reader only. Check computed_at below for how current this is.",
                "showDescription": true
              }
            }
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 6 }
        },
        {
          "widget": {
            "name": "engagement_table",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "engagement",
                  "fields": [
                    { "name": "book_id", "expression": "`book_id`" },
                    { "name": "engagement_score", "expression": "`engagement_score`" },
                    { "name": "current_highlights", "expression": "`current_highlights`" },
                    { "name": "questions", "expression": "`questions`" },
                    { "name": "computed_at", "expression": "`computed_at`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "book_id", "displayName": "Book" },
                  { "fieldName": "engagement_score", "displayName": "Engagement" },
                  { "fieldName": "current_highlights", "displayName": "Highlights" },
                  { "fieldName": "questions", "displayName": "Questions" },
                  { "fieldName": "computed_at", "displayName": "Source computed at" }
                ]
              },
              "frame": {
                "title": "Engagement per book, with its source timestamp",
                "showTitle": true
              }
            }
          },
          "position": { "x": 6, "y": 0, "width": 6, "height": 6 }
        },
        {
          "widget": {
            "name": "frontier_table",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "frontier",
                  "fields": [
                    { "name": "candidate_concept", "expression": "`candidate_concept`" },
                    { "name": "frontier_score", "expression": "`frontier_score`" },
                    { "name": "supporting_work_count", "expression": "`supporting_work_count`" },
                    { "name": "computed_at", "expression": "`computed_at`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "candidate_concept", "displayName": "Adjacent concept" },
                  { "fieldName": "frontier_score", "displayName": "Frontier score" },
                  { "fieldName": "supporting_work_count", "displayName": "Supporting works" },
                  { "fieldName": "computed_at", "displayName": "Source computed at" }
                ]
              },
              "frame": {
                "title": "Concepts adjacent to what has been read",
                "showTitle": true,
                "description": "A frontier concept has no direct evidence, so it does not appear under interests.",
                "showDescription": true
              }
            }
          },
          "position": { "x": 0, "y": 6, "width": 12, "height": 6 }
        }
      ]
    }
  ]
}
