              {
                "name": "main_query",
                "query": {
                  "datasetName": "engagement",
                  "fields": [
                    {
                      "name": "book_id",
                      "expression": "`book_id`"
                    },
                    {
                      "name": "title",
                      "expression": "`title`"
                    },
                    {
                      "name": "engagement_score",
                      "expression": "`engagement_score`"
                    },
                    {
                      "name": "current_highlights",
                      "expression": "`current_highlights`"
                    },
                    {
                      "name": "questions",
                      "expression": "`questions`"
                    },
                    {
                      "name": "computed_at",
                      "expression": "`computed_at`"
                    }
