{
  "datasets": [
    {
      "name": "interests",
      "displayName": "Reader interest profile",
      "queryLines": [
        "SELECT concept_id, interest_score, evidence_count, distinct_books,\n",
        "       score_version, computed_at\n",
        "FROM `marginalia_dev`.`dev_critesjosh_marginalia_scoped`.`reader_interest_profile`\n",
        "ORDER BY interest_score DESC"
      ],
      "catalog": "marginalia_dev",
      "schema": "dev_critesjosh_marginalia_scoped"
    },
    {
      "name": "engagement",
      "displayName": "Book engagement",
      "queryLines": [
        "SELECT book_id, title, engagement_score, active_minutes, session_count,\n",
        "       current_highlights, questions, completed, computed_at\n",
        "FROM `marginalia_dev`.`dev_critesjosh_marginalia_scoped`.`book_engagement`\n",
        "ORDER BY engagement_score DESC"
      ],
      "catalog": "marginalia_dev",
      "schema": "dev_critesjosh_marginalia_scoped"
    },
    {
      "name": "frontier",
      "displayName": "Intellectual frontier",
      "queryLines": [
        "SELECT candidate_concept, frontier_score, neighbour_count,\n",
        "       supporting_work_count, computed_at\n",
        "FROM `marginalia_dev`.`dev_critesjosh_marginalia_scoped`.`intellectual_frontier`\n",
        "ORDER BY frontier_score DESC"
      ],
      "catalog": "marginalia_dev",
      "schema": "dev_critesjosh_marginalia_scoped"
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "interests_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "interests",
                  "fields": [
                    {
                      "name": "concept_id",
                      "expression": "`concept_id`"
                    },
                    {
                      "name": "interest_score",
                      "expression": "`interest_score`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "showDescription": true,
                "title": "Interest by concept, normalized within this reader",
                "description": {
                  "value": "Scores are comparable within a reader only. Check computed_at below for how current this is.",
                  "fields": []
                }
              },
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "concept_id",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "interest_score",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "engagement_table",
