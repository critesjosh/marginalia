CHAT_ENABLED=true
# Optional: reading works without a key; local /api/chat returns 503 without one.
# Copy to .env.local and supply your own key. Never commit the populated file.
OPENROUTER_API_KEY=
# Optional: send dev chat to a deployed relay instead, e.g.
# https://rami.agenticpossible.com. Its key is billed; OPENROUTER_API_KEY is ignored.
CHAT_RELAY_URL=
# Thread links: set to false to stop publishing. Dev uses Turnstile's always-pass
# test keys unless TURNSTILE_SECRET_KEY / TURNSTILE_SITE_KEY are set.
THREADS_ENABLED=true
# Optional privacy-first telemetry (decision 0008, docs/telemetry.md), served by the
# dev server's relay. Off unless TELEMETRY_KEY is set. Use the public project key
# (phc_...), never a personal API key (phx_...). The browser never sees either.
TELEMETRY_KEY=
TELEMETRY_HOST=https://eu.i.posthog.com
# Preference before the reader chooses: regional (opt-in in the EU, EEA and
# Switzerland, opt-out with notice elsewhere) or off (opt-in everywhere). Browser
# privacy signals (GPC, Do Not Track) always start it off.
TELEMETRY_DEFAULT=regional
# Dev only: the country the local region check pretends the reader is in, e.g. GB.
# Unset means unknown, which gets the opt-in default.
TELEMETRY_DEV_COUNTRY=
